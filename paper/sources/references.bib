}

@article{xuComparativeStudyShallow2022,
  title = {A {{Comparative Study}} of {{Shallow Machine Learning Models}} and {{Deep Learning Models}} for {{Landslide Susceptibility Assessment Based}} on {{Imbalanced Data}}},
  author = {Xu, Shiluo and Song, Yingxu and Hao, Xiulan},
